---
import type { CollectionEntry } from 'astro:content';
import Photo from './Photo.astro';
import { wa, productMessage } from '../lib/site';
interface Props { product: CollectionEntry<'products'> }
const { product } = Astro.props;
const p = product.data;
const href = `/catalogo/${p.category.id}/${product.id}`;
---
<article class:list={['tile', 'tile-product', { 'tile-featured': p.featured }]}>
  {p.featured && <span class="badge">Destacado</span>}
  <Photo image={p.image} label={p.photoLabel || `Foto: ${p.title.toLowerCase()}`} />
  <div class="tile-body">
    <h2>{p.title}</h2>
    {p.summary && <p>{p.summary}</p>}
  </div>
  {p.hasPage
    ? <a class="btn btn-primary btn-sm" href={href}>Ver producto</a>
    : <a class="btn btn-ghost btn-sm" href={wa(productMessage(p))} aria-label={`Consultá por ${p.title} por WhatsApp`}>Consultá</a>}
</article>

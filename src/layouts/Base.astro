---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WaFloat from '../components/WaFloat.astro';
interface Props { title: string; description?: string; current?: string; waMessage?: string; home?: boolean }
const { title, description = 'Papelería personalizada e impresiones en Pablo Podestá, Buenos Aires. Consultá por WhatsApp.', current, waMessage, home = false } = Astro.props;
---
<!doctype html>
<html lang="es-AR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" href="/logo/dipa-logo.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;600&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,700&family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&display=swap" />
</head>
<body class:list={{ home }}>
  <div class="page">
    <Header current={current} headCta={home} />
    <main><slot /></main>
    <Footer rich={home} />
  </div>
  <WaFloat message={waMessage} />
</body>
</html>

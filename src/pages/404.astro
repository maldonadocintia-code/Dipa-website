---
import Base from '../layouts/Base.astro';
---
<Base title="Página no encontrada · DIPA">
  <div class="wrap main-pad" style="max-width:760px">
    <div class="page-head">
      <span class="kicker">Ups</span>
      <h1>No encontramos esta página</h1>
      <p>Puede que el producto ya no esté o que el enlace haya cambiado.</p>
    </div>
    <div class="row-wrap">
      <a class="btn btn-primary" href="/catalogo">Ver catálogo</a>
      <a class="btn btn-ghost" href="/">Ir al inicio</a>
    </div>
  </div>
</Base>

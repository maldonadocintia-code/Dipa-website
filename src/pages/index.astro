---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import Icon from '../components/Icon.astro';
import { wa, MSG_GENERAL, instagramUrl, site } from '../lib/site';

const MSG_NOT_FOUND = 'Hola DIPA! Busco algo que no vi en el catálogo';
const MSG_KIT = 'Hola DIPA! Quiero consultar por un kit de cumple';

const audiences = [
  { href: '/catalogo/escolares', photo: 'Foto: etiquetas escolares con nombre y grado', title: 'Escuelas y familias', text: 'Etiquetas con nombre y grado, planners, horarios con imán y todo para la vuelta al cole.', cta: 'Ver escolares' },
  { href: '/catalogo/para-emprendimientos', photo: 'Foto: tarjetas personales y stickers de un emprendimiento', title: 'Emprendedores y comercios', text: 'Tarjetas personales, stickers con logo, folletos y tarjetería para tu packaging.', cta: 'Ver para emprendimientos' },
  { href: '/catalogo/cumples', photo: 'Foto: mesa de cumple con banderines y toppers', title: 'Cumples y fechas especiales', text: 'Invitaciones, toppers, banderines y souvenirs. También Día de la Madre, Navidad, comuniones y más.', cta: 'Ver cumples' },
];
---
<Base title="DIPA · Papelería personalizada en Pablo Podestá" current="inicio" home>

  <!-- HERO -->
  <section class="hero">
    <div class="hero-circle" aria-hidden="true"></div>
    <div class="hero-blob" aria-hidden="true"></div>
    <div class="wrap hero-grid">
      <div class="hero-text">
        <Logo variant="lg" tone="dark" />
        <h1>Papelería personalizada, diseñada a tu medida.</h1>
        <p class="hero-lead">Etiquetas escolares, tarjetería para emprendimientos, kits de cumple y mucho más. Contanos qué necesitás y te pasamos el presupuesto por WhatsApp.</p>
        <div class="hero-btns">
          <a class="btn btn-primary" href={wa(MSG_GENERAL)}><Icon name="chat" size={22} />Consultá por WhatsApp</a>
          <a class="btn btn-ghost" href="/catalogo">Ver catálogo</a>
        </div>
      </div>
      <div class="hero-media">
        <div class="tape hero-tape" aria-hidden="true"></div>
        <div class="ph ph-paper hero-photo"><Icon name="image" size={28} stroke={1.8} />Foto: mesa de trabajo con papelería del local</div>
        <div class="ph ph-cream hero-photo-small">Foto: detalle de stickers</div>
        <span class="badge hero-badge">Listo en aprox. 5 días hábiles</span>
      </div>
    </div>
  </section>

  <!-- A MEDIDA -->
  <section aria-label="Trabajos a medida">
    <div class="wrap amedida">
      <div class="band amedida-mobile">
        <h2>¿No encontrás lo que buscás?</h2>
        <p>Escribinos: hacemos muchos trabajos a medida.</p>
        <a class="btn btn-cream" href={wa(MSG_NOT_FOUND)} style="margin-top:auto">Consultá por WhatsApp</a>
      </div>
      <div class="note">
        <div class="tape note-tape" aria-hidden="true"></div>
        <div class="note-main">
          <span class="note-ic" aria-hidden="true"><Icon name="search" size={28} /></span>
          <div class="stack" style="gap:4px">
            <h2>¿No encontrás lo que buscás?</h2>
            <p>Escribinos: hacemos muchos trabajos a medida.</p>
          </div>
        </div>
        <a class="btn btn-primary" href={wa(MSG_NOT_FOUND)}><Icon name="chat" size={22} />Consultá por WhatsApp</a>
      </div>
    </div>
  </section>

  <!-- AUDIENCIAS -->
  <section class="aud">
    <div class="wrap aud-in">
      <div class="aud-head">
        <span class="kicker kicker-brown">¿Para quién es?</span>
        <h2>Papelería para cada ocasión</h2>
      </div>
      <div class="aud-grid">
        {audiences.map((a) => (
          <a class="card-link aud-card" href={a.href}>
            <div class="ph ph-cream">{a.photo}</div>
            <div class="aud-body">
              <h3>{a.title}</h3>
              <p>{a.text}</p>
              <span class="card-cta">{a.cta} <Icon name="arrow" size={18} stroke={2.2} /></span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- DESTACADOS -->
  <section style="background: var(--c-cream)">
    <div class="wrap dest">
      <div class="stack-6">
        <span class="kicker">Lo más pedido</span>
        <h2 class="sec-h" style="color: var(--c-terracotta)">Destacados</h2>
      </div>
      <div class="dest-grid">
        <article class="feat">
          <div class="ph">Foto: tarjetas personales y folletos impresos</div>
          <div class="feat-body">
            <span class="badge self-start">Para emprendimientos</span>
            <h3>Tarjetería y publicidad para tu emprendimiento</h3>
            <p>Todo lo que tu marca necesita en papel, con tu logo y tus colores.</p>
            <div class="tags">
              <span class="tag">Tarjetas personales</span><span class="tag">Folletos</span><span class="tag">Stickers con logo</span><span class="tag">Tags</span><span class="tag only-mobile">Tarjetería para packaging</span>
            </div>
            <a class="btn btn-secondary self-start" href="/catalogo/para-emprendimientos">Ver productos</a>
          </div>
        </article>
        <article class="feat">
          <div class="ph">Foto: kit de cumple con invitación, toppers y banderines</div>
          <div class="feat-body">
            <span class="badge self-start">Cumples</span>
            <h3>Kits de cumple</h3>
            <p>De la invitación al souvenir: armamos todo con la temática que elijas.</p>
            <div class="tags">
              <span class="tag">Invitación digital</span><span class="tag">Toppers</span><span class="tag">Banderines</span><span class="tag only-mobile">Tarjeta de souvenir</span><span class="tag only-mobile">Deco para fondo de fotos</span><span class="tag only-desk">Souvenirs</span>
            </div>
            <a class="btn btn-secondary self-start" href={wa(MSG_KIT)}>Consultá por tu kit</a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- INSTAGRAM -->
  <section style="background: var(--c-lightgreen)">
    <div class="wrap ig">
      <div class="ig-head">
        <div class="stack" style="gap:4px">
          <h2 class="sec-h">Seguinos en Instagram</h2>
          <p style="font-weight:500">Novedades, trabajos terminados y promos en <a href={instagramUrl} style="color: var(--c-brown); font-weight: 700">@{site.instagramUser}</a></p>
        </div>
        <a class="btn btn-ghost ig-btn-desk" href={instagramUrl}><Icon name="instagram" size={20} />Ir a @{site.instagramUser}</a>
      </div>
      <div class="ig-grid">
        {[1, 2, 3, 4, 5, 6].map((n) => <div class="ph ph-cream">Post de Instagram {n}</div>)}
      </div>
      <a class="btn btn-ghost self-start ig-btn-mobile" href={instagramUrl}><Icon name="instagram" size={20} />Ir a @{site.instagramUser}</a>
    </div>
  </section>

  <!-- CTA FINAL -->
  <section style="background: var(--c-cream)">
    <div class="wrap cta-wrap">
      <div class="cta">
        <div class="cta-text">
          <h2>¿Tenés una idea? Contanos.</h2>
          <p>Escribinos por WhatsApp y te ayudamos a elegir. Todo se hace a pedido y personalizado.</p>
        </div>
        <a class="btn btn-cream" href={wa(MSG_GENERAL)}>Consultá por WhatsApp</a>
      </div>
    </div>
  </section>

</Base>

<style>
  /* Mobile values from Main.dc.html; ≥ 900 px values from Inicio-Desktop.dc.html */
  .hero { position: relative; overflow: hidden; }
  .hero-circle { position: absolute; width: 260px; height: 260px; border-radius: 50%; background: var(--c-lightgreen); right: -90px; top: 40px; }
  .hero-blob { position: absolute; width: 140px; height: 140px; border-radius: 60% 40% 55% 45%; background: var(--c-peach); left: -50px; bottom: 120px; opacity: 0.55; }
  .hero-grid { position: relative; padding-top: 40px; padding-bottom: 56px; display: flex; flex-direction: column; gap: 24px; }
  .hero-text { display: flex; flex-direction: column; gap: 24px; }
  .hero h1 { font-size: 32px; color: var(--c-brown); }
  .hero-lead { font-size: 17px; max-width: 520px; }
  .hero-btns { display: flex; flex-wrap: wrap; gap: 12px; }
  .hero-media { position: relative; margin-top: 16px; }
  .hero-tape { top: -12px; left: 50%; width: 96px; margin-left: -48px; transform: rotate(-4deg); }
  .hero-photo { aspect-ratio: 4 / 3; width: 100%; border-radius: var(--r-lg); }
  .hero-photo-small { display: none; }
  .hero-badge { position: absolute; left: 12px; bottom: -14px; box-shadow: 0 4px 12px rgba(79,44,29,0.15); z-index: 3; }

  .amedida { padding-top: 16px; padding-bottom: 48px; display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 16px; }
  .note { display: none; }

  .aud { background: var(--c-sage); border-radius: 40px 40px 0 0; }
  .aud-in { padding-top: 48px; padding-bottom: 48px; display: flex; flex-direction: column; gap: 24px; }
  .aud-head { display: flex; flex-direction: column; gap: 6px; }
  .aud-head h2, .sec-h { font-size: 28px; color: var(--c-brown); }
  .aud-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 16px; }
  .aud-card { display: flex; flex-direction: column; gap: 14px; background: var(--c-paper); border-radius: var(--r-lg); padding: 14px 14px 20px; }
  .aud-card .ph { aspect-ratio: 16 / 10; width: 100%; }
  .aud-body { display: flex; flex-direction: column; gap: 6px; padding: 0 6px; }
  .aud-body h3 { font-size: 22px; }

  .dest { padding-top: 56px; padding-bottom: 56px; display: flex; flex-direction: column; gap: 28px; }
  .dest-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 24px; }
  .feat { display: flex; flex-direction: column; gap: 16px; background: var(--c-paper); border-radius: var(--r-lg); padding: 16px 16px 24px; border: 1px solid var(--c-line-soft); }
  .feat > .ph { aspect-ratio: 4 / 3; width: 100%; }
  .feat-body { display: flex; flex-direction: column; gap: 12px; padding: 0 4px; }
  .feat-body h3 { font-size: 24px; color: var(--c-terracotta); }
  .feat-body .btn { margin-top: 4px; }

  .ig { padding-top: 48px; padding-bottom: 48px; display: flex; flex-direction: column; gap: 20px; }
  .ig-head { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 12px; }
  .ig-btn-desk { display: none; }
  .ig-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; }
  .ig-grid .ph { aspect-ratio: 1 / 1; border-radius: var(--r-sm); font-size: 12px; padding: 6px; }

  .cta-wrap { padding-top: 48px; padding-bottom: 48px; }
  .cta { background: var(--c-terracotta); border-radius: var(--r-lg); padding: 32px 24px; display: flex; flex-direction: column; gap: 16px; align-items: flex-start; }
  .cta-text { display: flex; flex-direction: column; gap: 16px; }
  .cta h2 { font-size: 28px; color: #fff; }
  .cta p { color: #fff; }

  @media (min-width: 900px) {
    .hero-circle { width: 520px; height: 520px; right: -140px; top: -60px; }
    .hero-blob { width: 220px; height: 220px; left: -80px; bottom: 40px; opacity: 0.5; }
    .hero-grid { padding-top: 72px; padding-bottom: 96px; display: grid; grid-template-columns: repeat(auto-fit, minmax(380px, 1fr)); gap: 56px; align-items: center; }
    .hero-text { gap: 28px; }
    .hero h1 { font-size: 54px; }
    .hero-lead { font-size: 20px; }
    .hero-btns { gap: 14px; }
    .hero-media { margin-top: 0; padding: 20px 0 20px 40px; }
    .hero-tape { top: 8px; width: 120px; height: 30px; margin-left: -40px; z-index: 3; }
    .hero-photo { aspect-ratio: 5 / 4; font-size: 15px; }
    .hero-photo svg { width: 32px; height: 32px; }
    .hero-photo-small { display: flex; position: absolute; left: 0; bottom: 0; width: 180px; aspect-ratio: 1 / 1; border-radius: var(--r-md); transform: rotate(-3deg); box-shadow: 0 10px 24px rgba(79,44,29,0.15); z-index: 2; }
    .hero-badge { left: auto; right: 16px; bottom: 0; }

    .amedida { padding-top: 8px; padding-bottom: 72px; display: block; }
    .amedida-mobile { display: none; }
    .note { position: relative; background: var(--c-paper); border: 2px dashed var(--c-terracotta); border-radius: var(--r-lg); padding: 28px 36px; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 20px 32px; }
    .note-tape { top: -14px; left: 48px; width: 100px; transform: rotate(-3deg); z-index: auto; }
    .note-main { display: flex; align-items: center; gap: 20px; flex: 1 1 520px; min-width: 0; }
    .note-ic { flex: 0 0 auto; width: 60px; height: 60px; border-radius: var(--r-md); background: var(--c-peach); color: var(--c-brown); display: flex; align-items: center; justify-content: center; }
    .note h2 { font-size: 26px; color: var(--c-terracotta); }
    .note p { font-size: 18px; }

    .aud { border-radius: 56px 56px 0 0; }
    .aud-in { padding-top: 80px; padding-bottom: 80px; gap: 36px; }
    .aud-head { gap: 8px; align-items: center; text-align: center; }
    .aud-head h2, .sec-h { font-size: 42px; }
    .aud-grid { grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 24px; }
    .aud-card { gap: 18px; padding: 16px 16px 28px; }
    .aud-card .ph { aspect-ratio: 4 / 3; }
    .aud-body { gap: 8px; padding: 0 8px; }
    .aud-body h3 { font-size: 26px; }
    .aud-body .card-cta { margin-top: 6px; }

    .dest { padding-top: 88px; padding-bottom: 88px; gap: 40px; }
    .dest .stack-6 { gap: 8px; }
    .dest-grid { grid-template-columns: repeat(auto-fit, minmax(420px, 1fr)); gap: 32px; }
    .feat { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 24px; padding: 20px; align-items: center; }
    .feat > .ph { aspect-ratio: 3 / 4; }
    .feat-body { gap: 14px; padding: 8px 8px 8px 0; }
    .feat-body h3 { font-size: 28px; }

    .ig { padding-top: 72px; padding-bottom: 72px; gap: 28px; }
    .ig-head { gap: 16px; }
    .ig-head .stack { gap: 6px !important; }
    .ig-btn-desk { display: inline-flex; }
    .ig-btn-mobile { display: none; }
    .ig-grid { grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 14px; }
    .ig-grid .ph { border-radius: var(--r-md); font-size: 14px; padding: 12px; }

    .cta-wrap { padding-top: 80px; padding-bottom: 80px; }
    .cta { border-radius: 40px; padding: 56px 48px; flex-direction: row; flex-wrap: wrap; gap: 24px; align-items: center; justify-content: space-between; }
    .cta-text { gap: 10px; max-width: 620px; }
    .cta h2 { font-size: 40px; }
    .cta p { font-size: 19px; }
  }
</style>
